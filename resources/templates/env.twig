# Configuration de {{ app.appName }}{{ withUser ? '' : ' — modèle : copiez ce fichier vers .env' }}.
# Les variables d'environnement réelles du serveur l'emportent sur ce fichier.
APP_NAME="{{ app.appName }}"
APP_ENV={{ withUser ? 'dev' : 'prod' }}
# Affiche le détail des erreurs. Ne jamais activer en production.
APP_DEBUG={{ withUser ? '1' : '0' }}
APP_PER_PAGE=20
# APP_BASE_PATH=/{{ app.appName }}

DB_DSN="{{ app.dsn|env }}"
DB_USER="{{ withUser ? app.dbUser|env : '' }}"
# Le mot de passe n'est jamais écrit par gene : renseignez-le ici.
DB_PASSWORD=""
