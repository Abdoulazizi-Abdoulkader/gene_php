# Configuration de Demo — modèle : copiez ce fichier vers .env.
# Les variables d'environnement réelles du serveur l'emportent sur ce fichier.
APP_NAME="Demo"
APP_ENV=prod
# Affiche le détail des erreurs. Ne jamais activer en production.
APP_DEBUG=0
APP_PER_PAGE=20
# APP_BASE_PATH=/Demo

DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=gene_test;charset=utf8mb4"
DB_USER=""
# Le mot de passe n'est jamais écrit par gene : renseignez-le ici.
DB_PASSWORD=""
